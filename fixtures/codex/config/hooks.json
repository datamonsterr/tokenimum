{
  "description": "Jev skill routing",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'~/.local/share/otherskill/bin/otherskill' 'find' '--agent' 'codex' '--home' '~'",
            "timeout": 66,
            "additionalContextLimit": 100000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook codex"
          }
        ]
      }
    ]
  }
}
